# Root .gitignore for the Report Decommissioning project.

# ── Generated outputs (may contain sensitive HR data) ─────────────────────────
output/
*.db
*.sqlite
*.sqlite3

# Excel / spreadsheet outputs and raw data exports (treat all as sensitive)
*.xlsx
*.xls
*.csv

# ── Python runtime ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Virtual environments ────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── OS / editor artefacts ──────────────────────────────────────────────────────
.DS_Store
__MACOSX/
Thumbs.db
*.swp
.idea/
.vscode/

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
.env.*
secrets.yaml
secrets.yml

# ── Temp upload staging ────────────────────────────────────────────────────────
tmp/
temp/

# Local Claude Code settings (per-machine, not shared)
.claude/

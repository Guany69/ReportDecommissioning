# Root .gitignore for the Report Decommissioning project.

# ── Generated outputs (may contain sensitive HR data) ─────────────────────────
output/
*.db
*.sqlite
*.sqlite3

# Excel / spreadsheet outputs and raw data exports (treat all as sensitive)
*.xlsx
*.xls
*.csv

# Local ML weights/checkpoints and reviewer data may contain company metadata.
*.pt
*.pth
*.ckpt
*.split.json
models/*
!models/.gitkeep
data/training/*
!data/training/.gitkeep

# ── Python runtime ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ── Virtual environments ────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── OS / editor artefacts ──────────────────────────────────────────────────────
.DS_Store
__MACOSX/
Thumbs.db
*.swp
.idea/
.vscode/

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
.env.*
secrets.yaml
secrets.yml

# ── Temp upload staging ────────────────────────────────────────────────────────
tmp/
temp/

# Local editor / tool settings (per-machine, not shared)
.claude/
